          "candidate": {
            "$ref": "#/components/schemas/SealedArtifact"
          },
          "experimentProposal": {
            "$ref": "#/components/schemas/SealedArtifact"
          },
          "hypothesis": {
            "$ref": "#/components/schemas/SealedArtifact"
          },
          "measurementIdentitySignature": {
            "$ref": "#/components/schemas/IdentitySignature"
          },
          "program": {
            "$ref": "#/components/schemas/SealedArtifact"
          },
          "prospectiveProtocol": {
            "$ref": "#/components/schemas/SealedArtifact"
          },
          "providerResultEnvelope": {
            "$ref": "#/components/schemas/SealedArtifact"
          },
          "providerResultIdentitySignature": {
            "$ref": "#/components/schemas/IdentitySignature"
          },
          "rawChainOfCustodyBase64": {
            "contentEncoding": "base64",
            "type": "string"
          },
          "rawMeasurementBase64": {
            "contentEncoding": "base64",
            "type": "string"
          },
          "rawSubmissionReceiptBase64": {
            "contentEncoding": "base64",
            "type": "string"
          },
          "submissionIdentitySignature": {
            "$ref": "#/components/schemas/IdentitySignature"
          }
        },
        "required": [
          "candidate",
          "program",
          "hypothesis",
          "experimentProposal",
          "prospectiveProtocol",
          "rawSubmissionReceiptBase64",
          "submissionIdentitySignature",
          "providerResultEnvelope",
          "providerResultIdentitySignature",
          "rawChainOfCustodyBase64",
          "rawMeasurementBase64",
          "measurementIdentitySignature"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "Auth Hub access token or API key",
        "description": "Opaque bearer verified through the Auth Hub /v1/oauth/introspect endpoint.",
        "scheme": "bearer",
        "type": "http",
        "x-tempera-auth-audience": "tempera-bio",
