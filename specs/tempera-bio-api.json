  "info": {
    "description": "Phase-specific biological discovery derivation. This API does not persist releases or execute physical experiments.",
    "title": "Tempera Bio Discovery API",
    "version": "1.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "getBioHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "const": "ok"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The process is alive."
          }
        },
        "security": [],
        "summary": "Liveness probe"
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getBioOpenapiDocument",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "This OpenAPI document."
          }
        },
        "security": [],
        "summary": "Serve this document"
      }
    },
