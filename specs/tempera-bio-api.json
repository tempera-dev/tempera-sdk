{
  "components": {
    "responses": {
      "Error": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Status"
            }
          }
        },
        "description": "A google.rpc.Status error envelope."
      }
    },
    "schemas": {
      "ArtifactResponse": {
        "additionalProperties": false,
        "properties": {
          "result": {
            "properties": {
              "contentDigest": {
                "pattern": "^sha256:[a-f0-9]{64}$",
                "type": "string"
              },
              "schemaVersion": {
                "type": "string"
              }
            },
            "required": [
              "schemaVersion",
              "contentDigest"
            ],
            "type": "object"
          }
        },
        "required": [
          "result"
        ],
        "type": "object"
      },
      "CampaignRound": {
        "additionalProperties": false,
        "properties": {
          "decision": {
            "$ref": "#/components/schemas/SealedArtifact"
          },
          "experimentProposal": {
            "$ref": "#/components/schemas/SealedArtifact"
          },
          "verifierReceipts": {
            "items": {
              "$ref": "#/components/schemas/SealedArtifact"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "experimentProposal",
          "verifierReceipts",
          "decision"
        ],
        "type": "object"
      },
      "DeriveCampaignStateRequest": {
        "additionalProperties": false,
        "properties": {
          "candidateSet": {
            "$ref": "#/components/schemas/SealedArtifact"
          },
          "hypothesis": {
            "$ref": "#/components/schemas/SealedArtifact"
          },
          "program": {
            "$ref": "#/components/schemas/SealedArtifact"
          },
          "rounds": {
            "items": {
              "$ref": "#/components/schemas/CampaignRound"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "program",
          "hypothesis",
          "candidateSet",
          "rounds"
        ],
        "type": "object"
      },
      "DeriveDecisionRequest": {
        "additionalProperties": false,
        "properties": {
          "candidateSet": {
            "$ref": "#/components/schemas/SealedArtifact"
          },
          "experimentProposal": {
            "$ref": "#/components/schemas/SealedArtifact"
          },
          "hypothesis": {
            "$ref": "#/components/schemas/SealedArtifact"
          },
          "program": {
            "$ref": "#/components/schemas/SealedArtifact"
          },
          "verifierReceipts": {
            "items": {
              "$ref": "#/components/schemas/SealedArtifact"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "program",
          "hypothesis",
          "candidateSet",
          "experimentProposal",
          "verifierReceipts"
        ],
        "type": "object"
      },
      "IdentitySignature": {
        "additionalProperties": false,
        "properties": {
          "algorithm": {
            "minLength": 1,
            "type": "string"
          },
          "keyId": {
            "minLength": 1,
            "type": "string"
          },
          "signature": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "algorithm",
          "keyId",
          "signature"
        ],
        "type": "object"
      },
      "IngestMaveDBScoreSetRequest": {
        "additionalProperties": false,
        "properties": {
          "scoreSetUrn": {
            "pattern": "^urn:mavedb:[0-9]{8}-(?:[a-z]+|0)-[1-9][0-9]*$",
            "type": "string"
          }
        },
        "required": [
          "scoreSetUrn"
        ],
        "type": "object"
      },
      "PrepareCandidateSetRequest": {
        "additionalProperties": false,
        "properties": {
          "candidates": {
            "items": {
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "candidates"
        ],
        "type": "object"
      },
      "PrepareDatasetReleaseManifestRequest": {
        "additionalProperties": false,
        "properties": {
          "decision": {
            "$ref": "#/components/schemas/SealedArtifact"
          },
          "program": {
            "$ref": "#/components/schemas/SealedArtifact"
          },
          "verifierReceipts": {
            "items": {
              "$ref": "#/components/schemas/SealedArtifact"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "program",
          "decision",
          "verifierReceipts"
        ],
        "type": "object"
      },
      "PrepareExperimentProposalFromGymBatchRequest": {
        "additionalProperties": false,
        "properties": {
          "batchProposal": {
            "$ref": "#/components/schemas/SealedArtifact"
          },
          "campaignContext": {
            "$ref": "#/components/schemas/SealedArtifact"
          },
          "candidateSet": {
            "$ref": "#/components/schemas/SealedArtifact"
          },
          "program": {
            "$ref": "#/components/schemas/SealedArtifact"
          }
        },
        "required": [
          "program",
          "candidateSet",
          "campaignContext",
          "batchProposal"
        ],
        "type": "object"
      },
      "PrepareExperimentProposalRequest": {
        "additionalProperties": false,
        "properties": {
          "candidateSet": {
            "$ref": "#/components/schemas/SealedArtifact"
          },
          "program": {
            "$ref": "#/components/schemas/SealedArtifact"
          },
          "selectedCandidates": {
            "items": {
              "$ref": "#/components/schemas/SealedArtifact"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "program",
          "candidateSet",
          "selectedCandidates"
        ],
        "type": "object"
      },
      "PrepareHypothesisRequest": {
        "additionalProperties": false,
        "properties": {
          "hypothesis": {
            "type": "object"
          }
        },
        "required": [
          "hypothesis"
        ],
        "type": "object"
      },
      "PrepareProgramRequest": {
        "additionalProperties": false,
        "properties": {
          "candidateSet": {
            "$ref": "#/components/schemas/SealedArtifact"
          },
          "configuration": {
            "type": "object"
          },
          "hypothesis": {
            "$ref": "#/components/schemas/SealedArtifact"
          }
        },
        "required": [
          "configuration",
          "hypothesis",
          "candidateSet"
        ],
        "type": "object"
      },
      "PrepareProspectiveExperimentProtocolRequest": {
        "additionalProperties": false,
        "properties": {
          "configuration": {
            "type": "object"
          },
          "experimentProposal": {
            "$ref": "#/components/schemas/SealedArtifact"
          },
          "program": {
            "$ref": "#/components/schemas/SealedArtifact"
          }
        },
        "required": [
          "configuration",
          "program",
          "experimentProposal"
        ],
        "type": "object"
      },
      "SealedArtifact": {
        "description": "LowerCamel REST projection of a sealed artifact. Exact closed internal schemas remain published in contracts/ and retain their canonical snake_case digest representation.",
        "properties": {
          "contentDigest": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "type": "string"
          },
          "schemaVersion": {
            "type": "string"
          }
        },
        "required": [
          "schemaVersion",
          "contentDigest"
        ],
        "type": "object"
      },
      "Status": {
        "additionalProperties": false,
        "description": "The google.rpc.Status error envelope required of every Tempera API (AIP-193).",
        "properties": {
          "error": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "description": "The HTTP status code, repeated in the body so the envelope is self-describing.",
                "type": "integer"
              },
              "details": {
                "description": "Structured error details. Present but empty when there are none.",
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              "message": {
                "description": "A developer-facing description that is safe to log and safe to show.",
                "type": "string"
              },
              "requestId": {
                "description": "The server-assigned request identifier, mirrored from the x-request-id response header.",
                "type": "string"
              },
              "status": {
                "description": "The canonical google.rpc.Code name, for example INVALID_ARGUMENT.",
                "enum": [
                  "CANCELLED",
                  "UNKNOWN",
                  "INVALID_ARGUMENT",
                  "DEADLINE_EXCEEDED",
                  "NOT_FOUND",
                  "ALREADY_EXISTS",
                  "PERMISSION_DENIED",
                  "UNAUTHENTICATED",
                  "RESOURCE_EXHAUSTED",
                  "FAILED_PRECONDITION",
                  "ABORTED",
                  "OUT_OF_RANGE",
                  "UNIMPLEMENTED",
                  "INTERNAL",
                  "UNAVAILABLE",
                  "DATA_LOSS"
                ],
                "type": "string"
              }
            },
            "required": [
              "code",
              "status",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "VerifyMeasurementRequest": {
        "additionalProperties": false,
        "properties": {
          "candidate": {
            "$ref": "#/components/schemas/SealedArtifact"
          },
          "experimentProposal": {
            "$ref": "#/components/schemas/SealedArtifact"
          },
          "hypothesis": {
            "$ref": "#/components/schemas/SealedArtifact"
          },
          "identitySignature": {
            "$ref": "#/components/schemas/IdentitySignature"
          },
          "program": {
            "$ref": "#/components/schemas/SealedArtifact"
          },
          "rawMeasurementBase64": {
            "contentEncoding": "base64",
            "type": "string"
          }
        },
        "required": [
          "candidate",
          "program",
          "hypothesis",
          "experimentProposal",
          "rawMeasurementBase64",
          "identitySignature"
        ],
        "type": "object"
