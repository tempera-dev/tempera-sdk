{
  "components": {
    "responses": {
      "Error": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Status"
            }
          }
        },
        "description": "A google.rpc.Status error envelope."
      }
    },
    "schemas": {
      "ChatChoice": {
        "additionalProperties": {},
        "description": "One choice in a chat completion response.",
        "properties": {
          "finish_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "index": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "message": {
            "$ref": "#/components/schemas/ChatMessage"
          }
        },
        "required": [
          "index",
          "message"
        ],
        "type": "object"
      },
      "ChatCompletionRequest": {
        "additionalProperties": {},
        "description": "`POST /v1/chat/completions` request body (OpenAI Chat Completions shape).",
        "properties": {
          "byok": {
            "description": "Optional per-request BYOK flag. May also be signalled by `x-provider-key`.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "max_tokens": {
            "description": "Required upper bound used for pre-provider cost admission.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "messages": {
            "description": "Conversation so far.",
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array"
          },
          "model": {
            "description": "Target model id, e.g. `gpt-4o`, `claude-sonnet-5`, `glm-4`.",
            "type": "string"
          },
          "response_format": {
            "description": "OpenAI-compatible `text`, `json_object`, or `json_schema` policy. JSON\noutputs are validated locally before a buffered response is returned."
          },
          "stream": {
            "description": "When true the client wants SSE streaming. Not yet served (see handler).",
            "type": [
              "boolean",
              "null"
            ]
          },
          "temperature": {
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "tool_choice": {
            "$ref": "#/components/schemas/NullableChatToolChoice"
          },
          "tools": {
            "description": "Function tools made available for this request.",
            "items": {
              "$ref": "#/components/schemas/ChatToolDefinition"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "model",
          "messages",
          "max_tokens"
        ],
        "type": "object"
      },
      "ChatCompletionResponse": {
        "additionalProperties": {},
        "description": "`POST /v1/chat/completions` response body (OpenAI Chat Completions shape).",
        "properties": {
          "choices": {
            "items": {
              "$ref": "#/components/schemas/ChatChoice"
            },
            "type": "array"
          },
          "created": {
            "description": "Unix seconds.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "object": {
            "description": "Always `chat.completion` for the non-streaming path.",
            "type": "string"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        },
        "required": [
          "id",
          "object",
          "created",
          "model",
          "choices",
          "usage"
        ],
        "type": "object"
      },
      "ChatMessage": {
        "additionalProperties": {},
        "description": "A single chat message.",
        "properties": {
          "content": {
            "description": "Message content. The wire-presence wrapper distinguishes an omitted\nfield from the OpenAI assistant form `\"content\": null` used alongside\n`tool_calls`.",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "description": "Optional name of the author (OpenAI compatibility).",
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "description": "`system` | `user` | `assistant` | `tool`.",
            "type": "string"
          },
          "tool_call_id": {
            "description": "Correlates a `role: tool` result to an earlier assistant tool call.",
            "type": [
              "string",
              "null"
            ]
          },
          "tool_calls": {
            "description": "Tool calls emitted by an assistant. As with `content`, missing and\nexplicit `null` are distinct wire states.",
            "items": {
              "$ref": "#/components/schemas/ChatToolCall"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "role"
        ],
        "type": "object"
      },
      "ChatToolCall": {
        "additionalProperties": {},
        "description": "A tool invocation emitted by an assistant message.",
        "properties": {
          "function": {
            "$ref": "#/components/schemas/ChatToolCallFunction"
          },
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "function"
        ],
        "type": "object"
      },
      "ChatToolCallFunction": {
        "additionalProperties": {},
        "description": "A function's invocation payload in an OpenAI tool call.",
        "properties": {
          "arguments": {
            "description": "JSON is deliberately still encoded text on this wire surface, matching\nthe Chat Completions protocol.",
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "arguments"
        ],
        "type": "object"
      },
      "ChatToolChoice": {
        "description": "OpenAI accepts both a protocol mode (for example `auto`) and a named\nfunction selector. Modes remain strings so future provider modes survive a\ntyped pass-through rather than being rejected or erased.",
        "oneOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/components/schemas/NamedToolChoice"
          }
        ]
      },
      "ChatToolDefinition": {
        "additionalProperties": {},
        "description": "One OpenAI-compatible function tool declaration.",
        "properties": {
          "function": {
            "$ref": "#/components/schemas/ChatToolFunctionDefinition"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "function"
        ],
        "type": "object"
      },
      "ChatToolFunctionDefinition": {
        "additionalProperties": {},
        "description": "The function descriptor within a declared `tools` entry.",
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "parameters": {
            "description": "A native JSON Schema. Its contents are intentionally not re-modelled as\na Rust struct because JSON Schema itself is an extensible JSON language."
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "HealthResponse": {
        "description": "`GET /healthz` response.",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "type": "object"
      },
      "Model": {
        "description": "One entry in `GET /v1/models`.",
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "description": "Always `model`.",
            "type": "string"
          },
          "owned_by": {
            "description": "Owning provider, e.g. `openai`, `nvidia`, `anthropic`, `glm`, `kimi`.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "object",
          "owned_by"
        ],
        "type": "object"
      },
      "ModelList": {
        "description": "`GET /v1/models` response. A JSON object (never a bare array) so fields can\nbe added compatibly (style guide §5).",
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/Model"
            },
            "type": "array"
          },
          "nextPageToken": {
            "description": "Opaque AIP-158 continuation token. Absent on the final page.",
            "type": [
              "string",
              "null"
            ]
          },
          "object": {
            "description": "Always `list`.",
            "type": "string"
          }
        },
        "required": [
          "object",
          "data"
        ],
        "type": "object"
      },
      "NamedToolChoice": {
        "additionalProperties": {},
        "description": "A named-function form of OpenAI's `tool_choice` field.",
        "properties": {
          "function": {
            "$ref": "#/components/schemas/NamedToolChoiceFunction"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "function"
        ],
        "type": "object"
      },
      "NamedToolChoiceFunction": {
        "additionalProperties": {},
        "description": "Name selected by a [`NamedToolChoice`].",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "NullableChatToolChoice": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/ChatToolChoice"
          },
          {
            "type": [
              "string",
              "null"
            ]
          }
        ]
      },
      "ReadinessResponse": {
        "description": "`GET /readyz` response. It proves the configured admission control plane is\nreachable without exercising a billable provider call.",
        "properties": {
          "admission": {
            "type": "string"
          },
          "configured_models": {
            "minimum": 0,
            "type": "integer"
          },
          "ready": {
            "type": "boolean"
          }
        },
        "required": [
          "ready",
          "admission",
          "configured_models"
        ],
        "type": "object"
      },
      "ResponsesRequest": {
        "description": "`POST /v1/responses` request body (OpenAI Responses-style, thin skeleton).",
        "properties": {
          "byok": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "input": {
            "description": "Free-form input. The Responses API accepts a string or a structured\nlist; we keep the skeleton permissive with an untyped value."
          },
          "max_output_tokens": {
            "description": "Required upper bound used for pre-provider cost admission.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "model": {
            "type": "string"
          },
          "response_format": {
            "description": "OpenAI-compatible structured output policy. Structured streaming is\nrejected because final schema validation must precede response release."
          }
        },
        "required": [
          "model",
          "input",
          "max_output_tokens"
        ],
        "type": "object"
      },
      "ResponsesResponse": {
        "description": "`POST /v1/responses` response body (thin skeleton).",
        "properties": {
          "created": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "object": {
            "description": "Always `response`.",
            "type": "string"
          },
          "output_text": {
            "description": "Aggregated output text (skeleton).",
            "type": "string"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        },
        "required": [
          "id",
          "object",
          "created",
          "model",
          "output_text",
          "usage"
        ],
        "type": "object"
      },
      "Status": {
        "additionalProperties": false,
        "description": "The google.rpc.Status error envelope required of every Tempera API (AIP-193).",
        "properties": {
          "error": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "description": "The HTTP status code, repeated in the body so the envelope is self-describing.",
                "type": "integer"
              },
              "details": {
                "description": "Structured error details. Present but empty when there are none.",
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              "message": {
                "description": "A developer-facing description that is safe to log and safe to show.",
                "type": "string"
              },
              "requestId": {
                "description": "The server-assigned request identifier, mirrored from the x-request-id response header.",
                "type": "string"
              },
              "status": {
                "description": "The canonical google.rpc.Code name, for example INVALID_ARGUMENT.",
                "enum": [
                  "CANCELLED",
                  "UNKNOWN",
                  "INVALID_ARGUMENT",
                  "DEADLINE_EXCEEDED",
                  "NOT_FOUND",
                  "ALREADY_EXISTS",
                  "PERMISSION_DENIED",
                  "UNAUTHENTICATED",
                  "RESOURCE_EXHAUSTED",
                  "FAILED_PRECONDITION",
                  "ABORTED",
                  "OUT_OF_RANGE",
                  "UNIMPLEMENTED",
                  "INTERNAL",
                  "UNAVAILABLE",
                  "DATA_LOSS"
                ],
                "type": "string"
              }
            },
            "required": [
              "code",
              "status",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Usage": {
        "description": "Token accounting for a completion. `snake_case`, integer counts.",
        "properties": {
          "cache_read_tokens": {
            "description": "Cache-read tokens (Anthropic/GLM prompt caching). 0 when unused.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "completion_tokens": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "prompt_tokens": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "total_tokens": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "prompt_tokens",
          "completion_tokens",
          "total_tokens"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "description": "Static gateway token, or an Auth Hub token/API key with audience `tempera-llm` (or `tempera-code` during migration) carrying `model:invoke` (inference) / `model:read` (catalog).",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "OpenAI-compatible LLM gateway every Tempera product calls instead of hitting providers directly. Reserves maximum model cost before provider execution and settles exact usage afterward per the billing-credits contract.",
    "license": {
      "name": "MIT"
    },
    "title": "Tempera LLM Gateway API",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health.check",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Runtime is accepting requests"
          }
        },
        "tags": [
          "health"
        ],
        "x-tempera-auth-kind": "none"
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readiness.check",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Configured admission control plane is reachable and at least one model is registered"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "tags": [
          "health"
        ],
        "x-tempera-auth-kind": "none"
      }
    },
    "/v1/chat/completions": {
      "post": {
        "operationId": "chatCompletions.create",
        "parameters": [
          {
            "description": "Customer BYOK provider key; presence bills surcharge-only",
            "in": "header",
            "name": "x-provider-key",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "description": "Tenant provider connection id; resolved by the gateway and billed BYOK surcharge-only",
            "in": "header",
            "name": "x-tempera-connection-id",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "description": "Tenant-bound policy id required when model is tempera/auto",
            "in": "header",
            "name": "x-tempera-route-policy",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletionResponse"
                }
              }
            },
            "description": "Chat completion (non-streaming)",
            "headers": {
              "x-tempera-billable-micros": {
                "description": "Customer credit debit in micro-USD units",
                "schema": {
                  "format": "int64",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "x-tempera-provider-connection-id": {
                "description": "Resolved provider connection identity, when used",
                "schema": {
                  "type": "string"
                }
              },
              "x-tempera-provider-connection-revision": {
                "description": "Resolved provider connection revision, when used",
                "schema": {
                  "format": "int32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "x-tempera-request-id": {
                "description": "Stable request/trace identity",
                "schema": {
                  "type": "string"
                }
              },
              "x-tempera-route-policy-id": {
                "description": "Pinned route policy used by tempera/auto, when used",
                "schema": {
                  "type": "string"
                }
              },
              "x-tempera-route-policy-revision": {
                "description": "Pinned route policy revision used by tempera/auto, when used",
                "schema": {
                  "format": "int64",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "x-tempera-route-provider-revision": {
                "description": "Pinned provider endpoint revision used by tempera/auto, when used",
                "schema": {
                  "format": "int64",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "x-tempera-usage-event-id": {
                "description": "Committed immutable usage event",
                "schema": {
                  "type": "string"
                }
              },
              "x-tempera-usage-reservation-id": {
                "description": "Auth Hub usage reservation",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "402": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "chatCompletions"
        ],
        "x-tempera-auth-audience": "tempera-llm",
        "x-tempera-auth-kind": "oauthResource",
        "x-tempera-required-scope": "model:invoke"
      }
    },
    "/v1/models": {
      "get": {
        "operationId": "models.list",
        "parameters": [
          {
            "description": "Maximum models to return. Zero uses the default (50); values above 200\nare coerced to 200, as required by AIP-158.",
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "default": 50,
              "format": "int32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          {
            "description": "Opaque token returned as `nextPageToken` by the preceding request.",
            "in": "query",
            "name": "pageToken",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelList"
                }
              }
            },
            "description": "A page of configured models in stable registration order"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "models"
        ],
        "x-tempera-auth-audience": "tempera-llm",
        "x-tempera-auth-kind": "oauthResource",
        "x-tempera-required-scope": "model:read"
      }
    },
    "/v1/responses": {
      "post": {
        "operationId": "responses.create",
        "parameters": [
          {
            "description": "Customer BYOK provider key; presence bills surcharge-only",
            "in": "header",
            "name": "x-provider-key",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "description": "Tenant provider connection id; resolved by the gateway and billed BYOK surcharge-only",
            "in": "header",
            "name": "x-tempera-connection-id",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "description": "Tenant-bound policy id required when model is tempera/auto",
            "in": "header",
            "name": "x-tempera-route-policy",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResponsesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponsesResponse"
                }
              }
            },
            "description": "Response (JSON when non-streaming; SSE when stream:true, ending with tempera.usage.receipt or tempera.usage.reconciliation_required after upstream events)",
            "headers": {
              "x-tempera-billable-micros": {
                "description": "Customer credit debit; absent until an SSE stream settles",
                "schema": {
                  "format": "int64",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "x-tempera-provider-connection-id": {
                "description": "Resolved provider connection identity, when used",
                "schema": {
                  "type": "string"
                }
              },
              "x-tempera-provider-connection-revision": {
                "description": "Resolved provider connection revision, when used",
                "schema": {
                  "format": "int32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "x-tempera-request-id": {
                "description": "Stable request/trace identity",
                "schema": {
                  "type": "string"
                }
              },
