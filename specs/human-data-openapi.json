{
  "openapi": "3.1.0",
  "info": {
    "title": "Tempera Human Data API",
    "version": "0.2.0",
    "description": "Read-only live qualification evidence projected from Data Engine. Human Data does not duplicate durable review or release truth."
  },
  "tags": [
    {
      "name": "Qualifications",
      "description": "Live qualification evidence for reviewed training products."
    }
  ],
  "x-tempera-protocol-routes": [
    "/healthz",
    "/openapi.json"
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "getHumanDataHealth",
        "summary": "Liveness probe",
        "security": [],
        "responses": {
          "200": {
            "description": "The process is alive.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "const": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getHumanDataOpenapiDocument",
        "summary": "Serve this document",
        "security": [],
        "responses": {
          "200": {
            "description": "This OpenAPI document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/qualifications:compute": {
      "get": {
        "tags": [
          "Qualifications"
        ],
        "operationId": "computeQualification",
        "summary": "Compute live qualification evidence",
        "description": "Idempotently verifies the current product, manifest, and training release on every request and returns a stateless receipt only when all qualification conditions hold. Human Data authenticates nothing itself: it forwards the caller's bearer verbatim to Data Engine, so the token must carry the data-engine audience and the scopes listed in x-tempera-downstream-authorization. A token minted for a human-data audience is rejected by Data Engine, not by this service.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-tempera-auth-kind": "product",
        "x-tempera-required-scope": "training:publish",
        "x-tempera-downstream-authorization": {
          "service": "data-engine",
          "audience": "data-engine",
          "enforcedBy": "data-engine",
          "humanDataEnforces": "none: the bearer is shape-checked and forwarded verbatim",
          "requiredScopes": [
            {
              "scope": "dataset:read",
              "upstream": "GET /v1/projects/{project}/products/{productId}"
            },
            {
              "scope": "dataset:read",
              "upstream": "GET /v1/projects/{project}/products/{productId}/manifest"
            },
            {
              "scope": "training:publish",
              "upstream": "GET /v1/projects/{project}/training-releases/{releaseId}"
            }
          ]
        },
        "x-tempera-physical-action": false,
        "parameters": [
          {
            "name": "productId",
            "in": "query",
            "required": true,
            "description": "Data Engine product identifier within the configured project.",
            "schema": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,254}[A-Za-z0-9])?$"
            }
          },
          {
            "name": "releaseId",
            "in": "query",
            "required": true,
            "description": "Data Engine training release identifier within the configured project.",
            "schema": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,254}[A-Za-z0-9])?$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Live qualification evidence.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComputeQualificationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "405": {
            "$ref": "#/components/responses/Error"
          },
          "414": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "502": {
            "$ref": "#/components/responses/Error"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "A bearer Human Data neither mints nor validates. It is forwarded verbatim to Data Engine, which requires the data-engine audience."
      }
    },
    "responses": {
      "Error": {
        "description": "A google.rpc.Status error envelope.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Status"
            }
          }
        }
      }
    },
    "schemas": {
      "Status": {
        "type": "object",
        "description": "The google.rpc.Status error envelope required of every Tempera API (AIP-193).",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "status",
              "message"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "integer",
                "description": "The HTTP status code, repeated in the body so the envelope is self-describing."
              },
              "status": {
                "type": "string",
                "description": "The canonical google.rpc.Code name, for example INVALID_ARGUMENT.",
                "enum": [
                  "CANCELLED",
                  "UNKNOWN",
                  "INVALID_ARGUMENT",
                  "DEADLINE_EXCEEDED",
                  "NOT_FOUND",
                  "ALREADY_EXISTS",
                  "PERMISSION_DENIED",
                  "UNAUTHENTICATED",
                  "RESOURCE_EXHAUSTED",
                  "FAILED_PRECONDITION",
                  "ABORTED",
                  "OUT_OF_RANGE",
                  "UNIMPLEMENTED",
                  "INTERNAL",
                  "UNAVAILABLE",
                  "DATA_LOSS"
                ]
              },
              "message": {
                "type": "string",
                "description": "A developer-facing description that is safe to log and safe to show."
              },
              "details": {
                "type": "array",
                "description": "Structured error details. Present but empty when there are none.",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "requestId": {
                "type": "string",
                "description": "The server-assigned request identifier, mirrored from the x-request-id response header."
              }
            }
          }
        }
      },
      "ComputeQualificationResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project",
          "product",
          "trainingRelease",
          "independentReviewerCount",
          "qualityState",
          "trainingReleaseState",
          "rawHashOverlapCount",
          "verifyTime"
        ],
        "properties": {
          "project": {
            "description": "Canonical Data Engine project resource name.",
            "type": "string",
            "pattern": "^projects/[^/]+$"
          },
          "product": {
            "description": "Canonical Data Engine product resource name.",
            "type": "string",
            "pattern": "^projects/[^/]+/products/[^/]+$"
          },
          "trainingRelease": {
            "description": "Canonical Data Engine training release resource name.",
            "type": "string",
            "pattern": "^projects/[^/]+/trainingReleases/[^/]+$"
          },
          "independentReviewerCount": {
            "description": "Number of distinct resolved primary review tasks in the live manifest.",
            "type": "integer",
            "minimum": 2
          },
          "qualityState": {
            "description": "Live product quality state.",
            "type": "string",
            "const": "READY"
          },
          "trainingReleaseState": {
            "description": "Live training release state.",
            "type": "string",
            "const": "ACTIVE"
          },
          "rawHashOverlapCount": {
            "description": "Live raw-hash overlap count for the release.",
            "type": "integer",
            "const": 0
          },
          "verifyTime": {
            "description": "Time at which Human Data verified the live evidence.",
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
